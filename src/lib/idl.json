{
  "version": "0.1.0",
  "name": "academic_credentials",
  "instructions": [
    {
      "name": "initializeIssuer",
      "accounts": [
        { "name": "issuerState", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "issueCertificate",
      "accounts": [
        { "name": "issuerState", "isMut": false, "isSigner": false },
        { "name": "certificate", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": true, "isSigner": true },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "docHash", "type": { "array": ["u8", 32] } },
        { "name": "studentPubkey", "type": "publicKey" },
        { "name": "issueDate", "type": "i64" }
      ]
    },
    {
      "name": "revokeCertificate",
      "accounts": [
        { "name": "issuerState", "isMut": false, "isSigner": false },
        { "name": "certificate", "isMut": true, "isSigner": false },
        { "name": "admin", "isMut": false, "isSigner": true }
      ],
      "args": [
        { "name": "docHash", "type": { "array": ["u8", 32] } }
      ]
    }
  ],
  "accounts": [
    {
      "name": "IssuerState",
      "type": {
        "kind": "struct",
        "fields": [{ "name": "admin", "type": "publicKey" }]
      }
    },
    {
      "name": "CertificateAccount",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "issuer", "type": "publicKey" },
          { "name": "student", "type": "publicKey" },
          { "name": "docHash", "type": { "array": ["u8", 32] } },
          { "name": "issueDate", "type": "i64" },
          { "name": "isRevoked", "type": "bool" },
          { "name": "isInitialized", "type": "bool" }
        ]
      }
    }
  ]
}